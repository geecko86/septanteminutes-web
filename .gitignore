# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/
next.lock/
/.firebase

# yarn ux-check (dependency upgrade review)
/out-head/
/out-base/
/ux-report/

# production
/build
septanteminutes-*.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ServiceWorker
/public/sw*
/public/worker*.js

# build files
buildId.txt

# transcription pipeline cache (downloaded audio + raw ASR responses)
/.transcripts-cache/

# Generated storyboard/maxres2 frames and local thumbnail experiments
/.video-thumbnail-cache/
/public/generated/video-frames/

# dubbing pipeline cache (extracted chunks + Hibiki output)
/.dub-cache/

# dubbing TTS engine venvs (XTTS etc.)
/scripts/dub/.venv/
/scripts/dub/.venv-*

# Python bytecode caches
__pycache__/

# CosyVoice2 cloned repo (+ Matcha-TTS submodule) and downloaded model weights (~5GB)
/scripts/dub/.cosyvoice-repo/
/scripts/dub/.cosyvoice-models/

# framer backup
/framerbackup

# stray git worktrees left behind by background agent runs
/.claude/worktrees/

# machine-local Claude permissions and preferences
/.claude/settings.local.json
