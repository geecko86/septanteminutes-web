# --- .env (committed) ------------------------------------------------------
# Number of episodes. Used at build time to generate static paths.
# Update this manually before each deploy to match the count in public/js/data.json.
EPISODES_COUNT=95

# --- .env.local (gitignored — secrets only) --------------------------------
# Required by the transcription pipeline (yarn transcribe).
# ELEVENLABS_API_KEY=

# Optional: fallback backend for the Claude post-pass when the `claude` CLI
# is not installed/logged in on this machine.
# ANTHROPIC_API_KEY=
