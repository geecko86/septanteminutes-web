{
  "hosting": {
    "site": "septanteminutesbe",
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/index.html"
      },
      {
        "source": "/faq",
        "destination": "/faq.html"
      },
      {
        "source": "**",
        "destination": "/404.html"
      }
    ],
    "headers": [{
      "source": "**/*.css",
      "headers": [{
        "key": "Cache-Control",
        "value": "max-age=2592000"
      }]
    }, {
      "source": "**/*.webp",
      "headers": [{
        "key": "Cache-Control",
        "value": "max-age=31536000"
      }]
    }, {
      "source": "**/*.svg",
      "headers": [{
        "key": "Cache-Control",
        "value": "max-age=31536000"
      }]
    }, {
      "source": "**/*.png",
      "headers": [{
        "key": "Cache-Control",
        "value": "max-age=31536000"
      }]
    }, {
      "source": "**/*.ico",
      "headers": [{
        "key": "Cache-Control",
        "value": "max-age=31536000"
      }]
    }, {
      "source": "**/*.js",
      "headers": [{
        "key": "Cache-Control",
        "value": "max-age=2592000"
      }]
    }, {
      "source": "**/*.html",
      "headers": [{
        "key": "Cache-Control",
        "value": "max-age=2592000"
      }]
    }, {
      "source": "**/*.json",
      "headers": [{
        "key": "Cache-Control",
        "value": "max-age=300"
      }]
    }, {
      "source": "**/buildId.txt",
      "headers": [{
        "key": "Cache-Control",
        "value": "no-store"
      }]
    }]
  }
}
