{
  "hosting": {
    "site": "septanteminutesbe",
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/index.html"
      },
      {
        "source": "/faq",
        "destination": "/faq.html"
      },
      {
        "source": "/feed",
        "destination": "/rss.xml"
      },
      {
        "source": "/rss",
        "destination": "/rss.xml"
      },
      {
        "source": "**",
        "destination": "/404.html"
      }
    ],
    "headers": [{
      "source": "**",
      "headers": [{
        "key": "Content-Security-Policy",
        "value": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://res.cloudinary.com/ https://unpkg.com/react-spring-bottom-sheet/; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https://res.cloudinary.com/ https://framerusercontent.com https://anchor.fm https://unpkg.com/react-spring-bottom-sheet/ https://*.cloudfront.net https://res.cloudinary.com/ https://fonts.gstatic.com https://fonts.googleapis.com; img-src 'self' 'unsafe-inline' data: https://framerusercontent.com https://res.cloudinary.com/; media-src 'self' https://anchor.fm https://*.cloudfront.net; font-src 'self' 'unsafe-inline' data: https://res.cloudinary.com/ https://fonts.gstatic.com https://fonts.googleapis.com; object-src 'none';"
      }]
    }, {
      "source": "**/*.css",
      "headers": [{
        "key": "Cache-Control",
        "value": "max-age=2592000"
      }]
    }, {
      "source": "**/*.webp",
      "headers": [{
        "key": "Cache-Control",
        "value": "max-age=31536000"
      }]
    }, {
      "source": "**/*.svg",
      "headers": [{
        "key": "Cache-Control",
        "value": "max-age=31536000"
      }]
    }, {
      "source": "**/*.png",
      "headers": [{
        "key": "Cache-Control",
        "value": "max-age=31536000"
      }]
    }, {
      "source": "**/*.ico",
      "headers": [{
        "key": "Cache-Control",
        "value": "max-age=31536000"
      }]
    }, {
      "source": "**/*.js",
      "headers": [{
        "key": "Cache-Control",
        "value": "max-age=2592000"
      }]
    }, {
      "source": "**/*.html",
      "headers": [{
        "key": "Cache-Control",
        "value": "max-age=2592000"
      }]
    }, {
      "source": "**/*.json",
      "headers": [{
        "key": "Cache-Control",
        "value": "max-age=300"
      }]
    }, {
      "source": "**/buildId.txt",
      "headers": [{
        "key": "Cache-Control",
        "value": "no-store"
      }]
    }]
  }
}
